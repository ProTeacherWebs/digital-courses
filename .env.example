# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Модель для ответов (список: https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Google Drive как источник базы знаний (необязательно, иначе читается папка knowledge/)
# Локально: путь к JSON-ключу сервисного аккаунта (папка secrets/ в git не попадает)
GOOGLE_SERVICE_ACCOUNT_FILE=
# На Vercel вместо файла: почта и приватный ключ из JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Секрет для POST /api/reindex (заголовок x-reindex-secret)
REINDEX_SECRET=
